[Desktop Entry]
Type=Service
MimeType=inode/directory;
Actions=gdoc;gsheet;gslides;
X-KDE-Submenu=New Google file
X-KDE-Submenu[pt_BR]=Novo arquivo Google
Icon=folder-gdrive

[Desktop Action gdoc]
Name=Google Doc
Icon=x-office-document
Exec=/home/pelias/.local/bin/gdrive-new doc %f

[Desktop Action gsheet]
Name=Google Sheet
Icon=x-office-spreadsheet
Exec=/home/pelias/.local/bin/gdrive-new sheet %f

[Desktop Action gslides]
Name=Google Slides
Icon=x-office-presentation
Exec=/home/pelias/.local/bin/gdrive-new slides %f
