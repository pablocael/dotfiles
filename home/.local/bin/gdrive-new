#!/usr/bin/env bash
# Create a native Google Doc / Sheet / Slides in the Drive folder that was
# right-clicked in Dolphin (anywhere under ~/GoogleDrive), then open it in the
# browser. Outside ~/GoogleDrive the file goes to the root of My Drive.
# Used by ~/.local/share/kio/servicemenus/google-drive-new.desktop.
#   gdrive-new doc|sheet|slides [folder]
#   GDRIVE_NEW_NAME=...  skip the name prompt;  GDRIVE_NEW_DRYRUN=1  resolve only
set -uo pipefail
kind=${1:-}; dir=${2:-$HOME/GoogleDrive/My Drive}; dir=${dir%/}
R=$HOME/.local/bin/rclone; MNT=$HOME/GoogleDrive
DRIVES=$HOME/.config/rclone/gdrive-shared-drives.json
fail() { notify-send -a "Google Drive" -i dialog-error "Could not create the file" "$1"; echo "error: $1" >&2; exit 1; }

case $kind in
  doc)    mime=document;     label="Google Doc";    def="Untitled document";;
  sheet)  mime=spreadsheet;  label="Google Sheet";  def="Untitled spreadsheet";;
  slides) mime=presentation; label="Google Slides"; def="Untitled presentation";;
  *) fail "usage: gdrive-new doc|sheet|slides [folder]";;
esac

# Which Drive location is this folder? -> rclone remote + path inside it
parent=root; rel=""; remote="gdrive:"
case "$dir/" in
  "$MNT/My Drive/"*)
    rel=${dir#"$MNT/My Drive"}; rel=${rel#/};;
  "$MNT/Shared drives/"?*)
    rest=${dir#"$MNT/Shared drives/"}; dname=${rest%%/*}
    rel=${rest#"$dname"}; rel=${rel#/}
    parent=$(jq -r --arg n "$dname" '.[$n] // empty' "$DRIVES")
    [ -n "$parent" ] || fail "Unknown shared drive: $dname"
    remote="gdrive,team_drive=$parent:";;
  "$MNT/Shared with me/"?*)
    rel=${dir#"$MNT/Shared with me/"}; remote="gdrive,shared_with_me=true:";;
  "$MNT/"*)
    fail "Open My Drive, a shared drive, or a folder inside 'Shared with me' first.";;
esac
if [ -n "$rel" ]; then
  # (lsjson --stat on a folder returns it as the root, without an ID: list the
  #  parent folder and pick the entry by name instead)
  up=$(dirname -- "$rel"); [ "$up" = . ] && up=""
  parent=$("$R" lsjson --dirs-only "$remote$up" -q 2>/dev/null |
    jq -r --arg n "$(basename -- "$rel")" 'map(select(.Name == $n))[0].ID // empty')
  [ -n "$parent" ] || fail "Could not find this folder on Drive: $rel"
else
  "$R" about gdrive: -q >/dev/null 2>&1 || true   # refreshes the access token if needed
fi
token=$("$R" config dump 2>/dev/null | jq -r '.gdrive.token' | jq -r '.access_token // empty')
[ -n "$token" ] || fail "No Google Drive login (run: rclone config reconnect gdrive:)"

api() { printf 'Authorization: Bearer %s\n' "$token" | curl -sS -H @- "$@"; }

if [ "${GDRIVE_NEW_DRYRUN:-}" = 1 ]; then
  echo "folder: $dir"; echo "remote: $remote$rel"; echo "parent id: $parent"
  api "https://www.googleapis.com/drive/v3/files/$parent?supportsAllDrives=true&fields=name,mimeType" | jq -c .
  exit 0
fi

name=${GDRIVE_NEW_NAME:-}
if [ -z "$name" ]; then
  name=$(kdialog --title "New $label" --inputbox "Name:" "$def") || exit 0
fi
[ -n "$name" ] || exit 0

body=$(jq -n --arg n "$name" --arg m "application/vnd.google-apps.$mime" --arg p "$parent" \
  '{name: $n, mimeType: $m, parents: [$p]}')
resp=$(api -X POST -H 'Content-Type: application/json' -d "$body" \
  "https://www.googleapis.com/drive/v3/files?supportsAllDrives=true&fields=id,webViewLink")
link=$(jq -r '.webViewLink // empty' <<<"$resp")
[ -n "$link" ] || fail "$(jq -r '.error.message // "unknown error"' <<<"$resp" 2>/dev/null)"

xdg-open "$link" >/dev/null 2>&1 &
notify-send -a "Google Drive" -i folder-gdrive "Created $label" "“$name” — opening in the browser. It appears in Dolphin within a minute."
