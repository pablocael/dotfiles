[Unit]
Description=Google Drive at ~/GoogleDrive (rclone mount of gdrive-all:)
Documentation=https://rclone.org/commands/rclone_mount/

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
# Google Docs/Sheets/Slides show as .link.html files that open in the browser.
# Files are cached locally (max 10G, 3 days) so apps can open/seek them.
ExecStart=%h/.local/bin/rclone mount gdrive-all: %h/GoogleDrive \
  --vfs-cache-mode full --vfs-cache-max-size 10G --vfs-cache-max-age 72h \
  --dir-cache-time 30m --poll-interval 1m \
  --drive-export-formats link.html \
  --volname "Google Drive" --log-level NOTICE
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
